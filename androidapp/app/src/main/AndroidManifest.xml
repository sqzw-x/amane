<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 明文流量整体允许: 网络策略不能按用户在运行时填写的地址放开明文, 而自建服务默认是 http://<host>:8000.
         地址完全由用户输入, 非局域网部署应自备 HTTPS 反代 (见 docs/dev/android.md). -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Amane"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- window.open 的目标窗口; 每个弹窗一个实例. -->
        <activity
            android:name=".PopupActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density|layoutDirection"
            android:exported="false"
            android:supportsPictureInPicture="true" />

        <!-- 入口. 不声明 orientation: WebView 旋转不重建, 播放中的画面与页面状态因此不丢.
             深色切换 (uiMode) 与字体缩放不在 configChanges 内, 那两种变更下按保存的地址重建. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density|layoutDirection"
            android:exported="true"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
