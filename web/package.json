    "@mantine/hooks": "^9.7.3",
    "@mantine/notifications": "^9.7.3",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dompurify": "^3.4.17",
    "hls.js": "^1.7.3",
    "i18next": "^26.5.10",
    "i18next-browser-languagedetector": "^8.2.2",
    "liqe": "^3.8.8",
    "liquidjs": "^10.30.0",
