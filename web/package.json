    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-image-crop": "^11.1.2",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.16",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
